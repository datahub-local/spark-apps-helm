{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "schedule": [
    "* * * * 6"
  ],
  "automerge": false,
  "prCreation": "immediate",
  "automergeStrategy": "squash",
  "forkProcessing": "enabled",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)spark-apps/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "appVersion: \"(?<currentValue>.*?)\""
      ],
      "depNameTemplate": "apache/spark",
      "datasourceTemplate": "docker"
    }
  ],
  "includePaths": [
    "spark-apps/**"
  ]
}