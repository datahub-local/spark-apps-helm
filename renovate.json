{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>datahub-local/datahub-local-core//renovate-presets/default"],
  "includePaths": ["spark-apps/**"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)spark-apps/Chart\\.yaml$/"],
      "matchStrings": ["appVersion: \"(?<currentValue>.*?)\""],
      "depNameTemplate": "apache/spark",
      "datasourceTemplate": "docker"
    }
  ]
}
